{
  "name": "@lynx-js/luna-styles",
  "version": "0.0.1",
  "description": "CSS theme variables for the L.U.N.A project",
  "keywords": [
    "luna",
    "styles",
    "css",
    "theme",
    "tokens",
    "variables"
  ],
  "homepage": "https://github.com/lynx-family/lynx-ui/tree/main/luna/packages/luna-styles#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/lynx-family/lynx-ui",
    "directory": "luna/packages/luna-styles"
  },
  "license": "Apache-2.0",
  "author": "The Lynx Authors",
  "sideEffects": [
    "./dist/*.css"
  ],
  "type": "module",
  "exports": {
    ".": {
      "default": "./dist/index.css"
    },
    "./index.css": {
      "default": "./dist/index.css"
    },
    "./luna-light.css": {
      "default": "./dist/luna-light.css"
    },
    "./luna-dark.css": {
      "default": "./dist/luna-dark.css"
    },
    "./lunaris-light.css": {
      "default": "./dist/lunaris-light.css"
    },
    "./lunaris-dark.css": {
      "default": "./dist/lunaris-dark.css"
    }
  },
  "main": "./dist/index.css",
  "files": [
    "dist",
    "CHANGELOG.md",
    "LICENSE",
    "README.md"
  ],
  "scripts": {
    "build": "node ./scripts/sync-dist.mjs",
    "sync:readme": "node ./scripts/sync-readme.mjs"
  },
  "devDependencies": {
    "@dugyu/luna-styles": "0.3.1"
  },
  "publishConfig": {
    "access": "public"
  }
}
