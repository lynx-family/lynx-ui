{
  "name": "@lynx-js/luna-tailwind",
  "version": "0.0.1",
  "description": "TailwindCSS preset for the L.U.N.A project",
  "keywords": [
    "luna",
    "tailwind",
    "preset",
    "colors",
    "tokens"
  ],
  "homepage": "https://github.com/lynx-family/lynx-ui/tree/main/luna/packages/luna-tailwind#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/lynx-family/lynx-ui",
    "directory": "luna/packages/luna-tailwind"
  },
  "license": "Apache-2.0",
  "author": "The Lynx Authors",
  "sideEffects": false,
  "type": "module",
  "exports": {
