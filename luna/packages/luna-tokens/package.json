{
  "name": "@lynx-js/luna-tokens",
  "version": "0.2.2",
  "description": "Design tokens for the L.U.N.A project",
  "keywords": [
    "luna",
    "tokens",
    "design tokens",
    "theme",
    "colors"
  ],
  "homepage": "https://github.com/lynx-family/lynx-ui/tree/main/luna/packages/luna-tokens#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lynx-family/lynx-ui.git",
    "directory": "luna/packages/luna-tokens"
  },
  "license": "Apache-2.0",
  "author": "The Lynx Authors",
  "sideEffects": false,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./luna-light": {
      "types": "./dist/luna-light.d.ts",
      "import": "./dist/luna-light.js",
      "require": "./dist/luna-light.cjs"
    },
    "./luna-dark": {
      "types": "./dist/luna-dark.d.ts",
      "import": "./dist/luna-dark.js",
      "require": "./dist/luna-dark.cjs"
    },
    "./lunaris-light": {
      "types": "./dist/lunaris-light.d.ts",
      "import": "./dist/lunaris-light.js",
      "require": "./dist/lunaris-light.cjs"
    },
    "./lunaris-dark": {
      "types": "./dist/lunaris-dark.d.ts",
      "import": "./dist/lunaris-dark.js",
      "require": "./dist/lunaris-dark.cjs"
    }
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "CHANGELOG.md",
    "LICENSE",
    "README.md"
  ],
  "scripts": {
    "build": "rslib build"
  },
  "devDependencies": {
    "@lynx-js/luna-core": "workspace:*",
    "@rslib/core": "catalog:",
    "typescript": "catalog:"
  },
  "publishConfig": {
    "access": "public"
  }
