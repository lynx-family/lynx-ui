{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "noEmit": false,
    "declaration": true,
    "declarationMap": true,
    "outDir": "dist",
    "rootDir": "./src",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "sourceMap": true,
    "lib": ["ES2022"],
  },
  "include": ["src/**/*.ts", "src/**/*.d.ts"],
  "exclude": ["**/*.test.ts", "**/__tests__/**"],
  "references": [
    { "path": "../luna-core/tsconfig.build.json" },
  ],
}
