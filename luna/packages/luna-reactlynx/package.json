{
  "name": "@lynx-js/luna-reactlynx",
  "version": "0.2.1",
  "description": "Reactlynx theming primitives (provider/hooks) and optional runtime wrappers for the L.U.N.A project",
  "keywords": [
    "luna",
    "theme",
    "theming",
    "reactlynx",
    "lynx-ui",
    "react",
    "lynx"
  ],
  "homepage": "https://github.com/lynx-family/lynx-ui/tree/main/luna/packages/luna-reactlynx#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lynx-family/lynx-ui.git",
    "directory": "luna/packages/luna-reactlynx"
  },
  "license": "Apache-2.0",
  "author": "The Lynx Authors",
  "sideEffects": false,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./theming": {
      "types": "./dist/theming/index.d.ts",
      "import": "./dist/theming/index.js"
    },
    "./runtime": {
      "types": "./dist/runtime/index.d.ts",
      "import": "./dist/runtime/index.js"
    },
    "./runtime/global-props": {
      "types": "./dist/runtime/global-props.d.ts",
      "import": "./dist/runtime/global-props.js"
    }
  },
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "CHANGELOG.md",
    "LICENSE",
    "README.md"
  ],
  "scripts": {
    "build": "rslib build"
  },
  "dependencies": {
    "@lynx-js/luna-core": "workspace:*"
  },
  "devDependencies": {
    "@lynx-js/react": "catalog:",
    "@lynx-js/types": "catalog:",
    "@rsbuild/plugin-react": "catalog:",
    "@rslib/core": "catalog:",
    "@types/react": "catalog:",
    "typescript": "catalog:"
  },
  "peerDependencies": {
    "@lynx-js/react": ">=0.100.0",
    "@lynx-js/types": "*",
    "@types/react": "^18"
  },
  "publishConfig": {
    "access": "public"
  }
}
