{
  "name": "@lynx-js/skill-lynx-ui",
  "version": "3.133.2",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lynx-family/lynx-ui.git",
    "directory": "packages/skill-lynx-ui"
  },
  "license": "Apache-2.0",
  "author": {
    "name": "The Lynx Authors"
  },
  "sideEffects": false,
  "type": "module",
  "files": [
    "SKILL.md",
    "references",
    "reference.md",
    "examples.md"
  ],
  "scripts": {
    "check:references": "node ../../tools/skill-lynx-ui/check-references.mjs",
    "clean:generated": "node ../../tools/skill-lynx-ui/clean-generated.mjs",
    "generate:references": "node ../../tools/skill-lynx-ui/generate-references.mjs",
    "prepack": "pnpm run generate:references",
    "postpack": "pnpm run clean:generated",
    "test": "vitest run --config ../../tools/skill-lynx-ui/vitest.config.ts"
  },
  "devDependencies": {
    "@types/node": "^24",
    "vitest": "2.1.8"
  },
  "publishConfig": {
    "access": "public"
  }
}
