{
  "name": "@lynx-js/lynx-ui-receipe-luna",
  "version": "0.0.1",
  "description": "Experimental Luna layouts and themed controls for ReactLynx",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lynx-family/lynx-ui.git",
    "directory": "receipes/lynx-ui-receipe-luna"
  },
  "license": "Apache-2.0",
  "author": {
    "name": "The Lynx Authors"
  },
  "sideEffects": false,
  "type": "module",
  "main": "./dist/index.jsx",
  "module": "./dist/index.jsx",
  "types": "./dist/index.d.ts",
  "files": [
    "src",
    "!src/**/*.test.*",
    "!src/**/__tests__/**",
    "SKILL.md",
    "README.md",
    "LICENSE",
    "CHANGELOG.md",
    "dist/**"
  ],
  "scripts": {
    "build": "rslib build",
    "build:watch": "rslib build --watch"
  },
  "dependencies": {
    "@lynx-js/luna-core": "workspace:*",
    "@lynx-js/luna-reactlynx": "workspace:*",
    "@lynx-js/luna-tokens": "workspace:*",
    "@lynx-js/lynx-ui-button": "workspace:*",
    "@lynx-js/lynx-ui-switch": "workspace:*",
    "clsx": "catalog:"
  },
  "devDependencies": {
    "@lynx-js/react": "catalog:",
    "@lynx-js/types": "catalog:",
    "@rslib/core": "catalog:",
    "@types/react": "catalog:",
    "typescript": "catalog:"
  },
  "peerDependencies": {
    "@lynx-js/react": ">=0.100.0",
    "@lynx-js/types": "*",
    "@types/react": ">=18"
  },
  "publishConfig": {
    "access": "public"
  },
  "jsnext:source": "./src/index.tsx"
}
