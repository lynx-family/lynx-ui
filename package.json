{
  "name": "@lynx-js/lynx-ui-repo",
  "private": true,
  "description": "lynx-ui repo",
  "license": "Apache-2.0",
  "author": "The Lynx Authors",
  "type": "module",
  "scripts": {
    "build": "turbo build",
    "changeset": "changeset",
    "check": "pnpm run check:luna-vars && biome check --write --no-errors-on-unmatched --files-ignore-unknown=true && eslint . --cache --cache-strategy content && dprint check",
    "check:all": "pnpm run check && pnpm run check:mdx && pnpm run check:exports && pnpm run check:changed && pnpm run check:changesets && pnpm run check:manypkg && pnpm run check:sherif",
    "check:changed": "sh tools/checkChanged/checkChanged.sh",
    "check:changesets": "node tools/scripts/check-changeset-targets.mjs",
    "check:exports": "node tools/scripts/check-aggregate-exports.mjs",
    "check:luna-vars": "stylelint --allow-empty-input --config ./stylelint.config.cjs \"apps/**/*.css\" \"packages/**/*.css\"",
    "check:manypkg": "pnpm dlx @manypkg/cli check",
    "check:mdx": "node tools/scripts/check-mdx-top-level-esm.mjs",
    "check:sherif": "pnpm dlx sherif@latest",
    "check:skills-references": "pnpm --filter @lynx-js/skill-lynx-ui check:references",
    "coverage": "vitest --coverage",
    "ensure:skills-changeset": "node tools/skill-lynx-ui/ensure-changeset.mjs",
    "examples:build": "turbo build --filter='./apps/examples/*'",
    "examples:publish": "node tools/scripts/publish-examples.mjs",
    "fix:all": "pnpm run format && pnpm run fix:manypkg && pnpm run fix:sherif && pnpm check:mdx",
    "fix:changed": "sh tools/checkChanged/checkChanged.sh",
    "fix:changed:unsafe": "sh tools/checkChanged/checkChanged.sh --unsafe",
    "fix:manypkg": "pnpm dlx @manypkg/cli fix",
    "fix:sherif": "pnpm dlx sherif@latest --fix",
    "format": "dprint fmt",
    "genDoc": "pnpm tsx tools/typedoc/index.ts",
    "install:all": "pnpm install",
    "knip": "knip",
    "make-new-component": "tsx tools/make-new-component/index.ts",
    "prepare": "husky",
    "spell": "cspell lint --config cspell.jsonc --gitignore --no-progress --no-must-find-files --show-suggestions **",
    "test": "vitest",
    "version:packages": "pnpm ensure:skills-changeset && changeset version"
  },
  "nano-staged": {
    "*.{js,jsx,ts,tsx,mjs,cjs,md,json,jsonc}": [
      "eslint --cache --fix --no-warn-ignored",
      "biome lint --write --no-errors-on-unmatched --files-ignore-unknown=true",
      "dprint fmt --allow-no-files --"
    ],
    "**/*.mdx": [
      "dprint fmt --allow-no-files --"
    ],
    "packages/lynx-ui-*/docs/**/*.mdx": [
      "node tools/scripts/check-mdx-top-level-esm.mjs"
    ],
    "*.{css,sass,scss,less}": [
      "stylelint --allow-empty-input --config ./stylelint.config.cjs",
      "dprint fmt --allow-no-files --"
    ],
    "*.{toml,html,yml,yaml}": [
      "dprint fmt --allow-no-files --"
    ],
    "*package.json": "sort-package-json",
    "*": [
      "cspell lint --config cspell.jsonc --gitignore --no-must-find-files"
    ]
  },
  "devDependencies": {
    "@biomejs/biome": "1.9.4",
    "@changesets/cli": "2.28.1",
    "@cspell/eslint-plugin": "^8.17.1",
    "@eslint/js": "^9.17.0",
    "@lynx-js/qrcode-rsbuild-plugin": "catalog:",
    "@lynx-js/react-rsbuild-plugin": "catalog:",
    "@rsbuild/plugin-react": "catalog:",
    "@rslib/core": "catalog:",
    "@svitejs/changesets-changelog-github-compact": "^1.2.0",
    "@types/node": "^24",
    "@vitest/coverage-v8": "2.1.8",
    "@vitest/eslint-plugin": "^1.1.24",
    "cspell": "^8.17.1",
    "dprint": "^0.48.0",
    "eslint": "^9.17.0",
    "eslint-import-resolver-typescript": "^3.7.0",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-jsdoc": "^50.6.1",
    "eslint-plugin-jsonc": "^2.18.2",
    "eslint-plugin-n": "^17.15.1",
    "eslint-plugin-notice": "^1.0.0",
    "eslint-plugin-regexp": "^2.7.0",
    "eslint-plugin-unicorn": "^56.0.1",
    "globals": "^15.14.0",
    "husky": "^9.1.7",
    "jsonc-parser": "3.3.1",
    "knip": "^5.80.0",
    "nano-staged": "^0.8.0",
    "postcss-value-parser": "^4.2.0",
    "sort-package-json": "^2.12.0",
    "stylelint": "^17.11.0",
    "tsx": "^4.19.3",
    "turbo": "^2.9.3",
    "typedoc": "^0.28.0",
    "typescript": "catalog:",
    "typescript-eslint": "^8.19.1",
    "vitest": "2.1.8"
  },
  "packageManager": "pnpm@10.33.2",
  "engines": {
    "node": ">=24.0.0",
    "pnpm": "10.33.2"
  }
}
