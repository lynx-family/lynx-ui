{
  "$schema": "https://unpkg.com/@changesets/config@3.1.2/schema.json",
  "changelog": [
    "@svitejs/changesets-changelog-github-compact",
    {
      "repo": "lynx-family/lynx-ui"
    }
  ],
  "commit": false,
  "fixed": [
    [
      "@lynx-js/luna-core",
      "@lynx-js/luna-reactlynx",
      "@lynx-js/luna-styles",
      "@lynx-js/luna-tailwind",
      "@lynx-js/luna-tokens"
    ]
  ],
  "linked": [
    [
      "@lynx-js/lynx-ui",
      "@lynx-js/lynx-ui-*"
    ]
  ],
  "access": "public",
  "baseBranch": "main",
  "updateInternalDependencies": "patch",
  "ignore": [
    "lynx-ui-**-examples"
  ],
  "privatePackages": {
    "tag": false,
    "version": false
  }
}
